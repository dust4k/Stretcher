# Auth (required)
APP_PASSWORD=0000
AUTH_SECRET=generate-a-random-32-char-string

# Database — auto-injected when Neon is linked to the project (stretch_POSTGRES_URL)
# No manual DATABASE_URL needed if Neon is connected.

# Blob — auto-injected when a Vercel Blob store is linked (BLOB_READ_WRITE_TOKEN, BLOB_STORE_ID)

# OpenAI (required for AI stretch instructions)
OPENAI_API_KEY=sk-...

# Optional: Instagram session cookie for reliable Reel downloads
INSTAGRAM_SESSION_ID=
