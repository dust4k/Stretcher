# Auth
APP_PASSWORD=your-password-here
AUTH_SECRET=generate-a-random-32-char-string

# Database (Vercel Postgres or Neon)
DATABASE_URL=postgresql://user:pass@host:5432/stretcher

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# OpenAI
OPENAI_API_KEY=

# Optional: Instagram session cookie for reliable Reel downloads
# Get from browser DevTools → Application → Cookies → instagram.com → sessionid
INSTAGRAM_SESSION_ID=
